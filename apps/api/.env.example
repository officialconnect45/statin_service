PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://statin.com

# MongoDB Atlas connection string (database: statin_build)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/statin_build?retryWrites=true&w=majority

# Server-to-server key for admin endpoints (GET /api/v1/inquiries).
# Must match ADMIN_API_KEY in apps/web/.env.local. At least 32 random characters.
ADMIN_API_KEY=

# ── Mail (Brevo SMTP) ──────────────────────────────────────────────────────────
# Two senders: the main address for client/system mail, and a separate domain
# for bulk outreach so outreach can't hurt the main domain's reputation.
# MAIL_ENABLED=true
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=                           (Brevo → SMTP & API → SMTP login)
# SMTP_PASS=                           (Brevo SMTP key)
# MAIL_TEST_TO=you@example.com         ("Send test" in the admin goes here)

# Main sender (client communication, system emails)
# SMTP_FROM_NAME=Statin
# SMTP_FROM_EMAIL=hello@statin.io      (must be a verified sender in Brevo)
# MAIL_REPLY_TO=hello@statin.io        (optional, defaults to SMTP_FROM_EMAIL)

# Outreach sender (/admin/outreach). Required: outreach never uses the main address.
# OUTREACH_FROM_NAME=Statin
# OUTREACH_FROM_EMAIL=hello@statin.eu  (statin.eu must be authenticated in Brevo)
# OUTREACH_REPLY_TO=hello@statin.eu    (optional, defaults to OUTREACH_FROM_EMAIL)
# Optional: a separate Brevo account for outreach. Each falls back to SMTP_*.
# OUTREACH_SMTP_HOST=
# OUTREACH_SMTP_PORT=
# OUTREACH_SMTP_SECURE=
# OUTREACH_SMTP_USER=
# OUTREACH_SMTP_PASS=

# ── Database (if added later) ──────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/statin

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development
