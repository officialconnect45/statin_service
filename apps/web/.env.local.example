# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Next.js automatically loads .env.local (never committed to git).
#
# Rules:
#   NEXT_PUBLIC_*  → exposed to the browser (public)
#   everything else → server-only (never sent to browser)

# URL of the Express API (used by server components / server actions)
API_BASE_URL=http://localhost:4000/api/v1

# Publicly visible API URL (used by client components, if any)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Site URL (used for OG tags, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin (/admin) ───────────────────────────────────────────────────────────
# Do not write these by hand. From apps/web run:
#   npm run admin:password
# It prompts for the superadmin password and stores only a salted scrypt hash.
# ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# ADMIN_SESSION_SECRET=<random, at least 32 characters>

# Lets the admin dashboard read leads from the API (MongoDB).
# Must match ADMIN_API_KEY in apps/api/.env.
# ADMIN_API_KEY=<random, at least 32 characters>
