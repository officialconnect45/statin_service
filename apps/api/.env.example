PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://statin.com

# MongoDB Atlas connection string (database: statin_build)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/statin_build?retryWrites=true&w=majority

# Server-to-server key for admin endpoints (GET /api/v1/inquiries).
# Must match ADMIN_API_KEY in apps/web/.env.local. At least 32 random characters.
ADMIN_API_KEY=

# ── Outreach mail (/admin/outreach) ────────────────────────────────────────────
# MAIL_ENABLED=true
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Statin
# SMTP_FROM_EMAIL=hello@statin.io      (must be a verified sender in Brevo)
# MAIL_REPLY_TO=hello@statin.io        (optional, defaults to SMTP_FROM_EMAIL)
# MAIL_TEST_TO=you@example.com         ("Send test" in the admin goes here)

# ── Database (if added later) ──────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/statin

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development
