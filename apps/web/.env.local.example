# ─── Frontend Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Next.js automatically loads .env.local (never committed to git).
#
# Rules:
#   NEXT_PUBLIC_*  → exposed to the browser (public)
#   everything else → server-only (never sent to browser)

# URL of the Express API (used by server components / server actions)
API_BASE_URL=http://localhost:4000/api/v1

# Publicly visible API URL (used by client components, if any)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Site URL (used for OG tags, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin (/admin) ───────────────────────────────────────────────────────────
# Set these here or in your host's environment settings; no script needed.
# ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD=<superadmin password>
#
# Optional:
#   ADMIN_SESSION_SECRET=<random, at least 32 characters>  (derived from the
#     credentials when unset; changing the password signs everyone out)
#   ADMIN_PASSWORD_HASH=scrypt:...  (instead of ADMIN_PASSWORD, written by
#     `npm run admin:password`; ignored when ADMIN_PASSWORD is set)

# Lets the admin dashboard read leads from the API (MongoDB).
# Must match ADMIN_API_KEY in apps/api/.env.
# ADMIN_API_KEY=<random, at least 32 characters>

# ─── Website audit (/admin/audit) ─────────────────────────────────────────────
# Gemini powers keywords, rankings, prompts, competitors and fixes in audits.
# Free key: https://aistudio.google.com/apikey (sign in with Google → Create API key).
# Without it, audits still run with the measured technical checks only.
# GEMINI_API_KEY=<your key>
# Optional, defaults to gemini-3.5-flash:
# GEMINI_MODEL=gemini-3.5-flash
# Optional: comma-separated models tried in order when GEMINI_MODEL is busy
# (503), over quota (429) or unavailable (404). Each model gets one retry.
# Leave unset for the built-in list; set it empty to disable fallbacks.
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite
