PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://statin.com

# MongoDB Atlas connection string (database: statin_build)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/statin_build?retryWrites=true&w=majority

# ── Email (for sending inquiry notifications) ──────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=hello@statin.com
# SMTP_PASS=your-password
# NOTIFY_EMAIL=hello@statin.com

# ── Database (if added later) ──────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/statin

# ── Environment ────────────────────────────────────────────────────────────────
NODE_ENV=development
